HOST=<VM-IP>
PORTS_FRONTEND=8282
PORTS_BACKEND=8283
PORTS_ADMINER=8285

# Optional: only relevant on the deployment VM. The deployment workflow sets these
# at deploy time itself, so leave them empty for local development (Compose then
# builds from source and tags the image "conduit-frontend:local" / "conduit-backend:local").
FRONTEND_IMAGE=
BACKEND_IMAGE=
SECRET_KEY=<Ausgabe von openssl rand -base64 48>
DEBUG=False
DJANGO_SUPERUSER_PASSWORD=<dein Passwort>
POSTGRES_DB=conduit
POSTGRES_USER=conduit
POSTGRES_PASSWORD=<dein Passwort>